<control>
default_path=samples/
<global> ampeg_release=0.5
<region> sample=loop.wav lokey=60 hikey=60 pitch_keycenter=60 loop_mode=loop_continuous loop_start=2400 loop_end=7199 bend_up=1200 bend_down=-1200
<region> sample=loop2.wav lokey=62 hikey=62 pitch_keycenter=62 loop_mode=loop_continuous loop_start=2400 loop_end=7199 bend_up=2400 bend_down=-2400 bend_step=1200
<region> sample=loop.wav lokey=64 hikey=64 pitch_keycenter=64 loop_mode=loop_continuous loop_start=2400 loop_end=7199 bend_up=1200 bend_down=-2400
<region> sample=loop2.wav lokey=66 hikey=66 pitch_keycenter=66 loop_mode=loop_continuous loop_start=2400 loop_end=7199 bend_up=1200 bend_down=-1200
