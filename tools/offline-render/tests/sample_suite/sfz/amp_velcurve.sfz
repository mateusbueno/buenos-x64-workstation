<region> sample=a.wav lokey=65 hikey=65 pitch_keycenter=65 amp_velcurve_0=1 amp_velcurve_127=0
<region> sample=a.wav lokey=67 hikey=67 pitch_keycenter=67 amp_velcurve_64=1 amp_veltrack=-100
