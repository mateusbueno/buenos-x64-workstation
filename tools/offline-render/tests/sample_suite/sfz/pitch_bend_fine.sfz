<control>
default_path=samples/
<global> ampeg_release=0.2
<region> sample=loop.wav lokey=60 hikey=60 pitch_keycenter=60 loop_mode=loop_continuous loop_start=2400 loop_end=7199 bend_up=700 bend_down=-500
