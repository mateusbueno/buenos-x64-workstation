# Story 6.5 configure probes for the dev key provider, run by ctest (cmake -P). Usage: cmake -DMODE=<mode> -DSRC=<source dir> -DBIN=<scratch dir> -DPYTHON=<python3> -P dev_keys_probe.cmake
#   default_off_release : a Release configuration without any -DVELORA_DEV_KEY_PROVIDER leaves the provider OFF (the option default), and configures.
#   absent_when_off     : a configuration with VELORA_DEV_KEY_PROVIDER=OFF builds velora-offline-render (and engine-host on macOS) and neither holds any trace of the provider;
#                         the dev build next to it (BUILT = the main build tree, DEV_BIN) does, so the scan is not blind.
file(REMOVE_RECURSE "${BIN}")
file(MAKE_DIRECTORY "${BIN}")
if(MODE STREQUAL "default_off_release")
  execute_process(COMMAND ${CMAKE_COMMAND} -S ${SRC} -B ${BIN} -DCMAKE_BUILD_TYPE=Release -DVELORA_LIBRARIAN_TRUST_VARIANT=factory-test
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "a Release configuration with the factory-test trust variant must configure:\n${out}\n${err}")
  endif()
  file(STRINGS "${BIN}/CMakeCache.txt" line REGEX "^VELORA_DEV_KEY_PROVIDER:BOOL=")
  if(NOT line STREQUAL "VELORA_DEV_KEY_PROVIDER:BOOL=OFF")
    message(FATAL_ERROR "VELORA_DEV_KEY_PROVIDER must default to OFF in a Release configuration, cache says: ${line}")
  endif()
elseif(MODE STREQUAL "absent_when_off")
  execute_process(COMMAND ${CMAKE_COMMAND} -S ${SRC} -B ${BIN} -DVELORA_DEV_KEY_PROVIDER=OFF RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "configure with VELORA_DEV_KEY_PROVIDER=OFF failed:\n${out}\n${err}")
  endif()
  set(targets velora-offline-render)
  set(bins "${BIN}/tools/offline-render/velora-offline-render")
  if(APPLE)
    list(APPEND targets engine-host)
    list(APPEND bins "${BIN}/engine/host/macos/engine-host")
  endif()
  execute_process(COMMAND ${CMAKE_COMMAND} --build ${BIN} --target ${targets} -j 4 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "build with VELORA_DEV_KEY_PROVIDER=OFF failed:\n${out}\n${err}")
  endif()
  set(args)
  foreach(b ${bins})
    list(APPEND args --binary ${b})
  endforeach()
  execute_process(COMMAND ${PYTHON} -I ${SRC}/tools/ci/check_no_dev_keys.py ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  message(STATUS "${out}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "the build without the dev key provider still holds it:\n${out}\n${err}")
  endif()
  # Negative control: the same scan over the dev build (the main build tree) finds it.
  set(dargs)
  foreach(b ${DEV_BINS})
    list(APPEND dargs --binary ${b})
  endforeach()
  execute_process(COMMAND ${PYTHON} -I ${SRC}/tools/ci/check_no_dev_keys.py --expect-present ${dargs} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  message(STATUS "${out}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "the scan did not find the dev key provider in the dev build (the check is blind):\n${out}\n${err}")
  endif()
else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
