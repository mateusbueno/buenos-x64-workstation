.DS_Store
/build*/
/tools/oracle/.work/
__pycache__/
*.pyc

# Story 6.3: the content-pack tool locks the vendor ID register while it appends (and writes a temp file next to it)
/tools/content-pack/vendor-ids.lock
/tools/content-pack/vendor-ids.tmp

# Desktop build artifacts
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
node_modules/

# Story 1.4: Yocto layer clones and build output (KAS_BUILD_DIR=$PWD/.yocto-work/build), kas venv, CI artifact staging
/.yocto-work/
/.kas-venv/
/out/

# Story 5.4: the reference corpus is fetched into ~/.cache/velora-corpus (outside the tree); audio under tools/corpus is never committed
/tools/corpus/.cache/
/tools/corpus/work/
/tools/corpus/**/*.wav
/tools/corpus/**/*.flac
/tools/corpus/**/*.ogg
/tools/corpus/**/*.aif
/tools/corpus/**/*.aiff
/tools/corpus/**/*.mp3
/tools/corpus/**/*.wv
/tools/corpus/**/*.sf2
