// Salamander-style layout, restricted to the supported opcode subset (synthetic, no real data).
<control>
default_path=samples/

<global>
ampeg_release=0.6
loop_mode=no_loop

<group> lovel=1 hivel=40
<region> sample=A0v1.wav lokey=21 hikey=23 pitch_keycenter=21 tune=3
<region> sample=C1v1.wav lokey=24 hikey=26 pitch_keycenter=24
<group> lovel=41 hivel=80
<region> sample=A0v2.wav lokey=21 hikey=23 pitch_keycenter=21 tune=3
<region> sample=C1v2.wav lokey=24 hikey=26 pitch_keycenter=24

<group> lovel=1 hivel=127 trigger=release ampeg_release=0.1 volume=-12
<region> sample=rel1.wav key=21
<region> sample=rel2.wav key=24 seq_length=2 seq_position=1
<region> sample=rel3.wav key=24 seq_length=2 seq_position=2
