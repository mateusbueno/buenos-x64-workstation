{
  "version": 1,
  "comment": "Default Mac virtual panel mapping (Story 3.10). Keys mirror ui/src/virtual_panel.cpp; the MIDI control surface uses CC 21-29 for faders 1-9, CC 30-37 for encoders 1-8 (relative), CC 38 for VALUE (relative), CC 50-57 for part/scene buttons 1-8, CC 1 for the mod wheel and pitch bend for the pitch wheel. Edit freely: a malformed file is rejected whole.",
  "keys": [
    { "key": "escape", "button": "EXIT" },
    { "key": "x", "button": "EXIT" },
    { "key": "tab", "button": "MENU" },
    { "key": "m", "button": "MENU" },
    { "key": "return", "button": "WRITE" },
    { "key": "w", "button": "WRITE" },
    { "key": "space", "button": "VALUE_PUSH" },
    { "key": "v", "button": "VALUE_PUSH" },
    { "key": "up", "control": "VALUE_ENCODER", "delta": 1 },
    { "key": "right", "control": "VALUE_ENCODER", "delta": 1 },
    { "key": "]", "control": "VALUE_ENCODER", "delta": 1 },
    { "key": "+", "control": "VALUE_ENCODER", "delta": 1 },
    { "key": "=", "control": "VALUE_ENCODER", "delta": 1 },
    { "key": "down", "control": "VALUE_ENCODER", "delta": -1 },
    { "key": "left", "control": "VALUE_ENCODER", "delta": -1 },
    { "key": "[", "control": "VALUE_ENCODER", "delta": -1 },
    { "key": "-", "control": "VALUE_ENCODER", "delta": -1 },
    { "key": "pageup", "button": "LIVE_SET_PREV" },
    { "key": ",", "button": "LIVE_SET_PREV" },
    { "key": "pagedown", "button": "LIVE_SET_NEXT" },
    { "key": ".", "button": "LIVE_SET_NEXT" },
    { "key": "1", "button": "SCENE_PREV" },
    { "key": "2", "button": "SCENE_NEXT" },
    { "key": "f", "control": "PEDAL_SWITCH", "press": 1, "release": 0 },
    { "key": "q", "control": "WHEEL_PITCH", "press": 4095, "release": 2048 },
    { "key": "a", "control": "WHEEL_PITCH", "press": 0, "release": 2048 },
    { "key": "e", "control": "WHEEL_MOD", "press": 4095, "release": 0 }
  ],
  "midi": [
    { "pitch_bend": true, "control": "WHEEL_PITCH" },
    { "cc": 1, "control": "WHEEL_MOD" },
    { "cc": 21, "control": "FADER_1" },
    { "cc": 22, "control": "FADER_2" },
    { "cc": 23, "control": "FADER_3" },
    { "cc": 24, "control": "FADER_4" },
    { "cc": 25, "control": "FADER_5" },
    { "cc": 26, "control": "FADER_6" },
    { "cc": 27, "control": "FADER_7" },
    { "cc": 28, "control": "FADER_8" },
    { "cc": 29, "control": "FADER_9" },
    { "cc": 30, "control": "ENCODER_1", "mode": "relative" },
    { "cc": 31, "control": "ENCODER_2", "mode": "relative" },
    { "cc": 32, "control": "ENCODER_3", "mode": "relative" },
    { "cc": 33, "control": "ENCODER_4", "mode": "relative" },
    { "cc": 34, "control": "ENCODER_5", "mode": "relative" },
    { "cc": 35, "control": "ENCODER_6", "mode": "relative" },
    { "cc": 36, "control": "ENCODER_7", "mode": "relative" },
    { "cc": 37, "control": "ENCODER_8", "mode": "relative" },
    { "cc": 38, "control": "VALUE_ENCODER", "mode": "relative" },
    { "cc": 50, "button": "PART_SCENE_1" },
    { "cc": 51, "button": "PART_SCENE_2" },
    { "cc": 52, "button": "PART_SCENE_3" },
    { "cc": 53, "button": "PART_SCENE_4" },
    { "cc": 54, "button": "PART_SCENE_5" },
    { "cc": 55, "button": "PART_SCENE_6" },
    { "cc": 56, "button": "PART_SCENE_7" },
    { "cc": 57, "button": "PART_SCENE_8" }
  ]
}
